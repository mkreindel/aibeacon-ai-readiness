# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL and publishable key (sb_publishable_...).
# Public by design: they reach the browser and RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...). Server only: it bypasses RLS.
SUPABASE_SECRET_KEY=

# Random secret used to hash visitor IPs for the rate limit.
# Generate one with: openssl rand -hex 32
IP_HASH_SALT=

# OpenAI API key for the AI report. Server only. Without it, diagnostics are saved
# with report = null and the visitor sees a notice (docs/spec.md, section 7).
OPENAI_API_KEY=
